# HealthGrid IQ — Environment Variables
# Copy this file to .env and fill in the values.

# Firebase Configuration (optional — app works with mock data without these)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Note: If these are left blank, the app runs in demo mode
# using local mock data with localStorage persistence.
