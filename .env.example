# HealthGrid IQ — Environment Variables
# Copy this file to .env and fill in the values.

# ===== FIREBASE CONFIGURATION =====
# Get these from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ===== GOOGLE MAPS API =====
# Get API key from Google Cloud Console with Maps JavaScript API, Geocoding API, and Directions API enabled
VITE_GOOGLE_MAPS_API_KEY=

# ===== IAS (INTELLIGENT APPOINTMENT SYSTEM) INTEGRATION =====
# API endpoint for external scheduling system
VITE_IAS_API_ENDPOINT=https://api.ias-system.example.com
VITE_IAS_API_KEY=

# ===== FIREBASE FUNCTIONS CONFIGURATION (Backend) =====
# For Cloud Functions - set these in Firebase Functions config:
# firebase functions:config:set api.key="your-api-key-here"
API_KEY=your-secure-api-key-for-webhook-access

# ===== DEVELOPMENT MODE =====
# Note: If Firebase variables are left blank, the app runs in demo mode
# using local mock data with localStorage persistence.
