# HealthGrid IQ — Environment Variables
# Copy this file to .env and fill in the values.
# ⚠️  Never commit .env to version control — it contains secrets.

# ===== FIREBASE CONFIGURATION =====
# Get these from: Firebase Console → Project Settings → General → Your apps → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ===== GOOGLE MAPS API =====
# Get API key from Google Cloud Console with: Maps JavaScript API, Geocoding API, Directions API
VITE_GOOGLE_MAPS_API_KEY=

# ===== API BASE URL =====
# Points to your deployed Firebase Cloud Functions.
# Format: https://<region>-<project-id>.cloudfunctions.net/api
# For local emulator: http://localhost:5001/<project-id>/us-central1/api
VITE_API_BASE_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/api

# ===== IAS (INTELLIGENT APPOINTMENT SYSTEM) INTEGRATION =====
VITE_IAS_API_ENDPOINT=https://api.ias-system.example.com
VITE_IAS_API_KEY=

# ===== FIREBASE FUNCTIONS CONFIGURATION (Backend) =====
# Set these using the Firebase CLI (NOT in this file — they are server-side secrets):
#   firebase functions:config:set api.key="your-secret-webhook-key"
#   firebase functions:config:set app.allowed_origins="https://your-domain.com"
#
# For local emulator, set in functions/.env:
API_KEY=your-secure-webhook-api-key
ALLOWED_ORIGINS=https://your-domain.com,https://your-staging-domain.com
