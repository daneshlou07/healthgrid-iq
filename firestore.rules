rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------

    function isAuth() {
      return request.auth != null;
    }

    // Read role from JWT custom claim (fast path, set by Cloud Functions).
    // If not present, fall back to the user's Firestore document.
    // The users collection is readable by any authenticated user,
    // so this lookup is always permitted.
    function userRole() {
      return request.auth.token.get('role', null) != null
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '');
    }

    function hasRole(role) {
      return isAuth() && userRole() == role;
    }

    function isAdmin() {
      return hasRole('Administrator');
    }

    function isClinicalStaff() {
      return isAuth() && userRole() in [
        'Medical Officer', 'Radiology Department',
        'Radiographer', 'Radiologist', 'Administrator'
      ];
    }

    // -----------------------------------------------------------------------
    // Users collection — needed for role lookups above
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Clinics
    // -----------------------------------------------------------------------
    match /clinics/{clinicId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Patients
    // -----------------------------------------------------------------------
    match /patients/{patientId} {
      allow read: if isAuth();
      allow create, update: if isClinicalStaff();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Cases
    // -----------------------------------------------------------------------
    match /cases/{caseId} {
      allow read: if isAuth();
      allow create, update: if isClinicalStaff();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Reports
    // -----------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAuth();
      allow create, update: if isClinicalStaff();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Comments
    // -----------------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin() || (isAuth() && request.auth.uid == resource.data.userId);
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Patient requests
    // -----------------------------------------------------------------------
    match /patient_requests/{requestId} {
      allow read: if isAuth();
      allow create, update: if isClinicalStaff();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Audit logs — append-only
    // -----------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Mobile PACS vans
    // -----------------------------------------------------------------------
    match /mobile_pacs_vans/{vanId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Radiographer schedules
    // -----------------------------------------------------------------------
    match /radio_schedules/{scheduleId} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || hasRole('Radiology Department');
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // IAS Scheduling Jobs
    // -----------------------------------------------------------------------
    match /scheduling_jobs/{jobId} {
      allow read: if isAuth();
      allow create, update: if isAdmin() || hasRole('Radiology Department');
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Announcements
    // -----------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Notifications
    // -----------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin()
        || (isAuth()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Sessions
    // -----------------------------------------------------------------------
    match /sessions/{sessionId} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Trash
    // -----------------------------------------------------------------------
    match /trash/{trashItemId} {
      allow read, write: if isAdmin();
    }
  }
}
