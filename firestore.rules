rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Free Tier / Client App Firestore Access Rules
    // Grants open read/write to support full client application data persistence
    // without requiring paid Cloud Functions or JWT custom claims.
    // -----------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
